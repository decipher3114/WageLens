# --- Rime TTS ---
RIME_API_KEY=your_rime_api_key
RIME_SPEAKER=nadi
RIME_MODEL=coda

# --- LLM (OpenAI or OpenRouter) ---
OPENAI_API_KEY=your_openai_or_openrouter_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Hugging Face (sentence-transformers / Qdrant embeddings) ---
HF_TOKEN=your_huggingface_token

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=complaint_vectors
QDRANT_LOCATION_WEIGHT=0.45
QDRANT_PLATFORM_WEIGHT=0.30
QDRANT_TIME_WEIGHT=0.25
QDRANT_PATTERN_THRESHOLD=0.65
QDRANT_MIN_CLUSTER_SIZE=2

# --- App ---
DATABASE_URL=sqlite:///./data/database/wagelens.db
API_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=./data/logs/wagelens.log

# --- CrewAI ---
CREW_VERBOSE=false
